# LandLens environment template.
# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# Leave every value below empty here — placeholders only, no real secrets.

# OpenAI API key for the document assistant and valuation helpers.
OPENAI_API_KEY=

# Generation model name (open question, PRD section 9 — leave empty for now).
LLM_MODEL=

# Secret used to sign JWT session tokens.
JWT_SECRET=

# Database role passwords (roles per DEC-004: owner bootstraps, api and tiles are least-privilege).
# landlens_owner is the compose bootstrap user (POSTGRES_USER).
POSTGRES_PASSWORD=
LANDLENS_API_PASSWORD=
LANDLENS_TILES_PASSWORD=
